<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!--configSections-->
	<configSections>
		<sectionGroup name="spring">
			<section name="context" type="Spring.Context.Extension.ExtensionContextHandler,Spring.Extension"/>
			<section name="objects" type="Spring.Context.Support.DefaultSectionHandler, Spring.Core"/>
			<section name="parsers" type="Spring.Context.Support.NamespaceParsersSectionHandler, Spring.Core"/>
		</sectionGroup>

		<sectionGroup name="common">
			<section name="logging" type="Common.Logging.ConfigurationSectionHandler, Common.Logging"/>
		</sectionGroup>

		<sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
			<section name="Lead.CPrim.View.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
		</sectionGroup>
	</configSections>

	<!--Spring配置-->
	<spring>
		<context>
			<resource uri="assembly://Lead.CPrims.Framework.Common"/>
			<resource uri="assembly://Lead.CPrims.Framework.ProcessControl"/>
			<resource uri="assembly://Lead.CPrims.Framework.ProcessModel"/>
			<resource uri="assembly://Lead.CPrims.Framework.DynamicEntity"/>
		</context>
	</spring>

	<!--WCF配置 IP要改 域可缺省-->
	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="NetTcpBinding_IAppService" receiveTimeout="00:10:00" sendTimeout="00:10:00">
					<security mode="None"/>
				</binding>
				<binding name="NetTcpBinding_IProcessModelService" receiveTimeout="00:10:00" sendTimeout="00:10:00">
					<security mode="None"/>
				</binding>
				<binding name="NetTcpBinding_IProcessControlService" receiveTimeout="00:10:00" sendTimeout="00:10:00">
					<security mode="None"/>
				</binding>
				<binding name="NetTcpBinding_IDynamicEntityAppService" receiveTimeout="00:10:00" sendTimeout="00:10:00">
					<security mode="None"/>
				</binding>

				<binding name="NetTcpBinding_IHeartBeatService" receiveTimeout="00:10:00" sendTimeout="00:10:00">
					<security mode="None"/>
				</binding>
			</netTcpBinding>
		</bindings>
		<client>
			<endpoint address="net.tcp://10.30.66.201:8080/LeadService/commonService" binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IAppService" contract="CommonService.IAppService" name="NetTcpBinding_IAppService">
				<identity>
					<userPrincipalName value="18513@wifi.lead.com"/>
				</identity>
			</endpoint>

			<endpoint address="net.tcp://10.30.66.201:8080/LeadService/processModelService" binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IProcessModelService" contract="ProcessModel.IProcessModelService" name="NetTcpBinding_IProcessModelService">
				<identity>
					<userPrincipalName value="18513@wifi.lead.com"/>
				</identity>
			</endpoint>

			<endpoint address="net.tcp://10.30.66.201:8080/LeadService/processControlService" binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IProcessControlService" contract="ProcessControl.IProcessControlService" name="NetTcpBinding_IProcessControlService">
				<identity>
					<userPrincipalName value="18513@wifi.lead.com"/>
				</identity>
			</endpoint>

			<endpoint address="net.tcp://10.30.66.201:8080/LeadService/dynamicEntityService" binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IDynamicEntityAppService" contract="DynamicEntityService.IDynamicEntityAppService" name="NetTcpBinding_IDynamicEntityAppService">
				<identity>
					<userPrincipalName value="18513@wifi.lead.com"/>
				</identity>
			</endpoint>

			<endpoint address="net.tcp://10.30.66.201:8080/LeadService/HeartBeatService" binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IHeartBeatService" contract="HeartBeatService.IHeartBeatService" name="NetTcpBinding_IHeartBeatService"/>

		</client>
	</system.serviceModel>

	<!--runtime-->
	<startup useLegacyV2RuntimeActivationPolicy="true">
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
	</startup>

	<!--runtime-->
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<!--特别注意1：privatePath路径内不允许存在换行-->
			<probing privatePath="ExtLibs;ExtLibs\CommonServiceLocator;ExtLibs\LogLib;ExtLibs\OxyPlot;ExtLibs\NHibernate;ExtLibs\RobotMitsubishi;ExtLibs\SoftDog;ExtLibs\Spring;ExtLibs\Sys;ExtLibs\Sys\LiveCharts;ExtLibs\Sys\MongoDB;ExtLibs\Task;ExtLibs\TestReal;ExtLibs\TestReal\en;ExtLibs\TestReal\Plugin;ExtLibs\TestReal\ReportLibrary;ExtLibs\TestReal\SlicePlugin;ExtLibs\Third;ExtLibs\Third\Excel;ExtLibs\Third\OPC;ExtLibs\Third\RfidTools;ExtLibs\Tracking\Framework;ExtLibs\Tracking\ShareCommon;ExtLibs\VisioPrim;ExtLibs\VisioPrim\FocalSpec;ExtLibs\VisioPrim\Precitec;ExtLibs\VisioPrim\SuperSocket;InnerLibs;InnerLibs\Main;InnerLibs\Config;InnerLibs\Control;InnerLibs\Display;InnerLibs\Elements;InnerLibs\Interfaces;InnerLibs\Param;InnerLibs\Proxy;InnerLibs\Tasks;InnerLibs\Tool;InnerLibs\VisioPrims;StationControl;TrackingLibs;"/>
			<dependentAssembly>
				<assemblyIdentity name="log4net" publicKeyToken="669e0ddf0bb1aa2a" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-2.0.8.0" newVersion="2.0.8.0"/>
			</dependentAssembly>
		</assemblyBinding>
	</runtime>

	<!--Lead.CPrim.View.Properties-->
	<applicationSettings>
		<Lead.CPrim.View.Properties.Settings>
			<setting name="允许多开" serializeAs="String">
				<value>False</value>
			</setting>
		</Lead.CPrim.View.Properties.Settings>
	</applicationSettings>
</configuration>
