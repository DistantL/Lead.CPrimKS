<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
  </configSections>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0"/>
  </startup>
  <!--<startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>-->
  <appSettings>
    <add key="backGroudColor" value="grey" />
    <add key="foreGroudColor" value="lime" />
    <add key="language" value="Chinese" />
    <!--remind设置为距离到期时间提醒的时长，单位为日-->
    <add key="remind" value="200" />
    <!--showreport设置为true则显示报告页-->
    <add key="showReport" value="true" />
    <add key="themeColor" value="BlackGreyColor" />
    <add key="privatePath" value="Plugin;SlicePlugin" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="Plugin;SlicePlugin" />
    </assemblyBinding>
    <!-- WARNING: will load assemblies from remote locations as fully trusted! -->
    <loadFromRemoteSources enabled="true" />
    <gcAllowVeryLargeObjects enabled="true" />
  </runtime>
</configuration>