<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Info" internalLogFile="c:\temp\nlog-internal.txt">

	<variable name="machineLogDirectory" value="D:/CPrimlog/Machine Log/${date:yyyyMMdd}/hour_${date:HH}"/>
	<variable name="machineLogDirectoryError" value="D:/CPrimlog/Machine Log Error/${date:yyyyMMdd}"/>
	<variable name="hiveLogMachineErrorDirectory" value="D:/CPrimlog/HIVE Log/Machine Error/${date:yyyyMMdd}/hour_${date:HH}"/>
	<variable name="hiveLogMachineDataDirectory" value="D:/CPrimlog/HIVE Log/Machine Data/${date:yyyyMMdd}/hour_${date:HH}"/>
	<variable name="hiveLogMachineStateDirectory" value="D:/CPrimlog/HIVE Log/Machine State/${date:yyyyMMdd}"/>
	<variable name="remoteLogMachineErrorDirectory" value="D:/CPrimlog/HIVE Log/Remote Qualification/Machine Error/${date:yyyyMMdd}/hour_${date:HH}"/>
	<variable name="remoteLogMachineDataDirectory" value="D:/CPrimlog/HIVE Log/Remote Qualification/Machine Data/${date:yyyyMMdd}/hour_${date:HH}"/>
	<variable name="remoteLogMachineStateDirectory" value="D:/CPrimlog/HIVE Log/Remote Qualification/Machine State/${date:yyyyMMdd}"/>

	<extensions>
		<add assembly="NLog.WindowsIdentity"/>
		<add assembly="NLog.Mongo"/>
		<add assembly="MongoDB.Bson"/>
	</extensions>

	<targets async="true">
		<target xsi:type="Mongo"
				name="mongodb"
				includeDefaults="false"
				includeEventProperties ="true"
				connectionString="mongodb://localhost:27017"
				collectionName="CPrimLog"
				databaseName="Lead"
				cappedCollectionSize="20971520">
			<field name="TimeStamp" layout="${longdate}" bsonType = "DateTime" />
			<field name="Level" layout="${level:uppercase=true}"/>
			<property name="LogId" layout="${event-context:item=LogId}" bsonType ="Int64"/>
			<property name="Message" layout="${event-context:item=Message}" />
			<property name="Classification" layout="${event-properties:item=Classification}" />
			<property name="Location" layout="${event-properties:item=Location}" />
		</target>
		
		<target name="machineLogFile" xsi:type="File"
				layout="${longdate} | ${event-context:item=LogId} | ${level:uppercase=true} | ${event-context:item=Message} | ${event-context:item=Classification} | ${event-context:item=Location}"
				fileName="${machineLogDirectory}.txt"
				keepFileOpen="true"
				bufferSize = "1024"
				encoding="utf-8"
				archiveAboveSize="104857600"/>

		<target name="machineLogFileError" xsi:type="File"
				layout="${date:HH}:${date:mm}:${date:ss}--->${event-context:item=Message}"
				fileName="${machineLogDirectoryError}.txt"
				keepFileOpen="true"
				bufferSize = "1024"
				encoding="utf-8"
				archiveAboveSize="104857600"/>
		
		<target name="hiveLogMachineErrorFile" xsi:type="File"
				layout="${date:HH}:${date:mm}:${date:ss}--->${event-context:item=Message}"
				fileName="${hiveLogMachineErrorDirectory}.txt"
				keepFileOpen="true"
				bufferSize = "1024"
				encoding="utf-8"
				archiveAboveSize="104857600"/>
		
		<target name="hiveLogMachineDataFile" xsi:type="File"
				layout="${date:HH}:${date:mm}:${date:ss}--->${event-context:item=Message}"
				fileName="${hiveLogMachineDataDirectory}.txt"
				keepFileOpen="true"
				encoding="utf-8"
				bufferSize = "1024"
				archiveAboveSize="104857600"/>
		
		<target name="hiveLogMachineStateFile" xsi:type="File"
				layout="${date:HH}:${date:mm}:${date:ss}--->${event-context:item=Message}"
				fileName="${hiveLogMachineStateDirectory}.txt"
				keepFileOpen="true"
				bufferSize = "1024"
				encoding="utf-8"
				archiveAboveSize="104857600"/>
		
		<target name="remoteLogMachineErrorFile" xsi:type="File"
				layout="${event-context:item=Message}"
				fileName="${remoteLogMachineErrorDirectory}.txt"
				keepFileOpen="true"
				bufferSize = "1024"
				encoding="utf-8"
				archiveAboveSize="104857600"/>
		
		<target name="remoteLogMachineDataFile" xsi:type="File"
				layout="${event-context:item=Message}"
				fileName="${remoteLogMachineDataDirectory}.txt"
				keepFileOpen="true"
				bufferSize = "1024"
				encoding="utf-8"
				archiveAboveSize="104857600"/>
		
		<target name="remoteLogMachineStateFile" xsi:type="File"
				layout="${event-context:item=Message}"
				fileName="${remoteLogMachineStateDirectory}.txt"
				keepFileOpen="true"
				bufferSize = "1024"
				encoding="utf-8"
				archiveAboveSize="104857600"/>
		<word-coloring text="message" fontColor="Green" backgroundColor="Black"/>
	</targets>

	<rules>
		<!--TRACE,DEBUG,INFO,WARN,ERROR,FATAL-->
		<logger name="MachineLog" minlevel="Trace" writeTo="mongodb" />
		<logger name="MachineLog" minlevel="Trace" writeTo="machineLogFile" />

		<logger name="MachineLogError" minlevel="Trace" writeTo="mongodb" />
		<logger name="MachineLogError" minlevel="Trace" writeTo="machineLogFileError" />
		
		<logger name="HiveLogMachineError" minlevel="Trace" writeTo="mongodb" />
		<logger name="HiveLogMachineError" minlevel="Trace" writeTo="hiveLogMachineErrorFile" />
		
		<logger name="HiveLogMachineData" minlevel="Trace" writeTo="mongodb" />
		<logger name="HiveLogMachineData" minlevel="Trace" writeTo="hiveLogMachineDataFile" />
		
		<logger name="HiveLogMachineState" minlevel="Trace" writeTo="mongodb" />
		<logger name="HiveLogMachineState" minlevel="Trace" writeTo="hiveLogMachineStateFile" />
		
		<logger name="RemoteLogMachineError" minlevel="Trace" writeTo="mongodb" />
		<logger name="RemoteLogMachineError" minlevel="Trace" writeTo="remoteLogMachineErrorFile" />
		
		<logger name="RemoteLogMachineData" minlevel="Trace" writeTo="mongodb" />
		<logger name="RemoteLogMachineData" minlevel="Trace" writeTo="remoteLogMachineDataFile" />
		
		<logger name="RemoteLogMachineState" minlevel="Trace" writeTo="mongodb" />
		<logger name="RemoteLogMachineState" minlevel="Trace" writeTo="remoteLogMachineStateFile" />
	</rules>
</nlog>
